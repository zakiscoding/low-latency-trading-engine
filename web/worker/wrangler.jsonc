// Paper-trading site. Serves on workers.dev (no custom domain).
// Secrets (wrangler secret put): INGEST_SECRET, SESSION_SECRET, GITHUB_CLIENT_SECRET,
// GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET. Vars below are public identifiers.
{
  "name": "paper-trading",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/ingest", "/api/*", "/auth/*", "/admin", "/admin/*", "/admin.html"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "MarketHub" },
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" },
      { "name": "LIMITER", "class_name": "ClientRateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MarketHub", "Account", "Leaderboard", "ClientRateLimiter"] }],
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liKxyKXrKhKWlrIW",
    "GOOGLE_CLIENT_ID": "361366559717-cklk29g73t2ag2cfpttrr2b65eddo74e.apps.googleusercontent.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGAyGXMiIsotpwIc",
    "ACCESS_TEAM_DOMAIN": "https://billowing-mountain-e775.cloudflareaccess.com",
    "ACCESS_AUD": "913677aecc27c01f61edc57ef3804ec92b2d5804e04310fb0b2532691311a874"
  }
}
